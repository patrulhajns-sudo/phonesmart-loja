# Endereço do banco PostgreSQL.
# Local (sandbox/dev):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Em produção (Neon, Supabase, Railway...), cole a URL que o serviço te der.
# Exemplo Neon:
# DATABASE_URL=postgresql://usuario:senha@ep-algo-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Senha para entrar no painel /admin.
# TROQUE por uma senha forte antes de publicar o site!
ADMIN_PASSWORD=phonesmart2024
